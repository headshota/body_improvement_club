<h1>Performed Exercises</h1>

<%= link_to 'Create Performed Exercise', new_workout_performed_exercise_path, class: 'btn' %>

<% @performed_exercises.each do |performed_exercise| %>
  
  <article class="flex justify-space-between">
    <div>
      <header>
        <h3><%= performed_exercise.name %></h3>
      </header>
      <p><%= performed_exercise.description %></p>
    </div>
    <div class="flex flex-column justify-center">
      <div>
        <%= link_to 'Edit', edit_performed_exercise_path(performed_exercise), class: 'btn' %>
        <div class="flex-inline">
          <%= button_to "Delete", @performed_exercise, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: 'btn' %>
        </div>
      </div>
    </div>
  </article>
  
<% end %>

