<%# locals: (workout:, performed_exercise:, performed_set:, performed_set_counter: 0) %>
<tr id="<%= dom_id(performed_set, "row") %>">
  <td><%= performed_set_counter + 1 %></td>
  <td>---</td>
  <td>
    <%= turbo_frame_tag dom_id(performed_set, "weight") do %>
      <%= form_with model: performed_set do |form| %>
        <%= form.number_field :weight,
        value: number_with_precision(form.object.weight, strip_insignificant_zeros: true), 
        onfocusout: "this.form.requestSubmit()", 
        size: 5, autocomplete: "off", step: 0.1
         %>
      <% end %>
    <% end %>
  </td>
  <td>
    <%= turbo_frame_tag dom_id(performed_set, "reps") do %>
      <%= form_with model: performed_set do |form| %>
        <%= form.text_field :performed_reps, onfocusout: "this.form.requestSubmit()", size: 5, autocomplete: "off" %>
      <% end %>
    <% end %>
  </td>
  <td>
    <%= turbo_frame_tag dom_id(performed_set, "done") do %>
      <%= form_with model: performed_set do |form| %>
        <%= form.check_box "done", onchange: "this.form.requestSubmit()" %>
      <% end %>
    <% end %>
  </td>
  <td>
    <div><%= button_to "Delete", performed_set, method: :delete, class: "btn", data: { turbo_frame: dom_id(performed_exercise, "sets_turbo_frame") } %></div>
  </td>
</tr>
