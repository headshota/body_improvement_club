<h1>Exercises</h1>

<%= link_to 'Create Exercise', new_exercise_path, class: 'btn' %>

<% @exercises.each do |exercise| %>
  
  <article class="flex justify-space-between">
    <div>
      <header>
        <h3><%= exercise.name %></h3>
      </header>
      <p><%= exercise.description %></p>
    </div>
    <div class="flex flex-column justify-center">
      <div>
        <%= link_to 'Edit', edit_exercise_path(exercise), class: 'btn' %>
        <div style="display:inline-block">
          <%= button_to "Delete", @exercise, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: 'btn' %>
        </div>
      </div>
    </div>
  </article>
  
<% end %>

