<h1>Create Exercise</h1>

<%= form_with model: @exercise do |form| %>
  <div>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: false, placeholder: "Barbell Squat", class: "input" %>
  </div>
  <div>
    <%= form.text_area :description, required: true, placeholder: "Barbell Squat is a compound exercise.", class: "input" %>
  </div>
  <div>
    <%= form.submit 'Create Exercise', class: 'btn' %>
  </div>
<% end %>
