<h1>Create Exercise</h1>

<%= form_with model: @exercise do |form| %>
  <div>
    <%= form.text_field :title, required: true, autofocus: true, autocomplete: false %>
  </div>
  <div>
    <%= form.text_area :description, required: true %>
  </div>
  <div>
    <%= form.submit 'Create Exercise', class: 'btn' %>
  </div>
<% end %>
