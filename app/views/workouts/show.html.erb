<%= turbo_frame_tag "edit_workout_title" do %>
<h1>
<%= link_to @workout.name, edit_workout_path(@workout) %>
</h1>
<% end %>

<div>
  <% @workout.performed_exercises.each do |performed_exercise| %>
    <article style="padding: 5px 0;" class="flex justify-space-between">
      <div>
        <header><%= performed_exercise.exercise.name %></header>
        <% performed_exercise.performed_sets.each do |performed_set| %>
          <div class="flex">
            <div>Set <%= performed_set.id %></div>
            <div><%= link_to "Edit", edit_workout_performed_exercise_performed_set_path(@workout, performed_exercise, performed_set), class: "btn" %></div>
            <div><%= button_to "Delete", [@workout, performed_exercise, performed_set], method: :delete, class: "btn" %></div>
          </div>
        <% end %>
        <%= link_to "Add Set", workout_performed_exercise_performed_sets_path(@workout, performed_exercise), data: { turbo_method: :post } %>
      </div>
      <div><%= button_to "Remove Exercise", [@workout, performed_exercise], method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn" %></div>
    </article>
  <% end %>
</div>

<div>
  <%= link_to "Add Exercise", new_workout_performed_exercise_path(@workout.id), class: "btn" %>
</div>

<div>
  <%= link_to "Cancel Workout", @workout, data: { turbo_confirm: "Are you sure?", turbo_method: :delete }, class: "btn" %>
</div>
