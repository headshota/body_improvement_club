<%= render partial: "workout_name", locals: { workout: @workout, name_form_visible: @name_form_visible  } %>

<div data-controller="sortable" id="performed_exercises">
  <%= render  partial: "performed_exercises/performed_exercise", collection: @workout.performed_exercises, locals: { workout: @workout } %>
</div>

<div>
  <%= link_to "Add Exercise", new_workout_performed_exercise_path(@workout.id), class: "btn" %>
</div>

<div style="margin: 10px 0;" class="flex">
  <%= button_to "Finish Workout", @workout, data: { turbo_confirm: "Are you sure?" }, method: :patch, class: "btn", params: { finish_workout: true } %>
  <%= button_to "Cancel Workout", @workout, data: { turbo_confirm: "Are you sure?" }, method: :delete, class: "btn" %>
</div>
