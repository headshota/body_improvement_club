<h1>Workout</h1>
<div>
  <% if @current_workout.present? %>
    <%= link_to "Continue Ongoing Workout", edit_workout_path(@current_workout), class: "btn" %>
  <% end %>

  <%
    data = { turbo_method: :post }
    if @current_workout.present?
      data[:turbo_confirm] = "Are you sure you want to start new workout and cancel the ongoing one?"
    end
  %>
  <%= link_to "Start New Workout", Workout.new, class: "btn", data: data %>
</div>
<h1>Previous Workouts</h1>
<div>
  <%= render partial: "workout_overview", collection: @finished_workouts, as: :workout %>
</div>
